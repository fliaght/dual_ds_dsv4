# V4 interactive profile. Legacy interactive-200k.env links here.
# Model/image-specific rationale: Knowledge/recipes.md and Docs/kedb/runtime.md.
# Historical throughput and capacity observations: Knowledge/performance.md.

MAX_MODEL_LEN=131072
GPU_MEM_UTIL=0.80              # historical lower-pressure baseline; not a hard RAM limit
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192    # larger historical chunks increased workspace
BLOCK_SIZE=256                 # existing V4 runtime page granularity
KV_DTYPE=fp8
CUDAGRAPH_MODE=NONE            # old DeepGEMM path performs CPU/GPU sync during capture

# Requires the existing image's aux_stream loader patch in run-node.sh.
MTP_CONF='{"method":"mtp","num_speculative_tokens":2}'
