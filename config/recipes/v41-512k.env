# V4.1 EXL3 only. Site paths/pins belong in ignored cluster.conf.
# v41-256k with a 2 GiB KV pool: 1 GiB held 306,868 tokens, so 2 GiB covers 512K
# with margin. 1M would need ~4 GiB and leaves no room above the UMA guard.
# 2026-10-15: head MemFree settled at ~5.99 GiB, below the 6 GiB admission line.
# Not validated and not a site default; see Docs/kedb/memory.md.
RUNTIME=v41
MODEL="dealignai/DeepSeek-V4.1-Flash-UNCENSORED-EXL3-2.9bpw"
MODEL_REVISION=8a27b35fc5b145fa05ee965c7d7b243b047915f7
ENGRAM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
ENGRAM_REVISION=5254448103b6254fc646dacbca1cbbf20e9216c1
DOCKER_IMAGE="${V41_DOCKER_IMAGE:-ghcr.io/miaai-lab/deepseek-v4.1-flash-exl3-2x-dgx-sparks:2.9bpw}"
CONTAINER_NAME=vllm-dsv41-exl3
V41_MODEL_DIR="${V41_MODEL_DIR:-$HOME/models/DeepSeek-V4.1-Flash-UNCENSORED-EXL3-2.9bpw}"
V41_ENGRAM_DIR="${V41_ENGRAM_DIR:-$HOME/models/DeepSeek-V4.1-Flash-Engram}"
V41_CACHE_DIR="${V41_CACHE_DIR:-$HOME/.cache/dsv41-runtime}"
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS="${V41_MAX_NUM_BATCHED_TOKENS:-1024}"
GPU_MEM_UTIL=0.85
KV_CACHE_MEMORY_BYTES=2147483648
BLOCK_SIZE=64
SPEC_METHOD="${V41_SPEC_METHOD:-none}"
DSPARK_TOKENS=3
LANGUAGE_MODEL_ONLY=1
V41_IO_THREADS="${V41_IO_THREADS:-32}"
# Stop well before the historical 4 GiB line; this remains a best-effort guard.
WATCHDOG_THRESHOLD_MIB=8192
V41_BOOT_MARGIN_MIB=16384
V41_READY_TIMEOUT=3600
