# TensorFold (Python path) settings for this site, appended to the recipe's prod.env.example by
# `scripts/tf-service.sh setup` after the cluster.conf-derived values. Later assignments win
# (serve.sh sources prod.env with set -a). Keys removed from the example: unset.keys.
# Rationale: Docs/runbooks/tensorfold.md. Memory lines match our guard (8/4 GiB stop, 9/5 GiB requests).

# One slot: the Python batcher can crash both ranks when a request queues behind long decodes
# (upstream #13, not fixed on this path). The chat UI queue is the only admission queue.
CONTEXT=425984
PARALLEL=1
KV_DTYPE=fp8
MAX_TOKENS=32768
HOST=127.0.0.1
ALIASES="DeepSeek-V4.1-Flash-TF"

# Exact output: full prefill (replay is approximate), no expert top-p pruning, fp32 mHC, DSpark off.
TF_DSV41_PREFILL=full
TF_DSV41_FULL_CONE=1
TF_DSV41_PREFILL_KERNELS=fast
TF_DSV41_DSPARK=0

# TF's 'usable' memory is ~MemFree plus small credits (measured), so these sit just above our guard.
TF_DSV41_FLOOR_GIB=7
TF_DSV41_FLOOR_HARD_GIB=6
TF_DSV41_PREFILL_ADAPT_GIB=6.5
TF_DSV41_ADMIT_FREE_FLOOR_GIB=5
TF_DSV41_GRAPH_FLOOR_GIB=6
TF_DSV41_FLOOR_PF_OTHER_GIB=1.0
TF_DSV41_PACK=site                         # skip the static 112 GiB load budget
TF_DSV41_ENGRAM_GATE_TIMEOUT_S=90          # first-boot Triton JIT
MALLOC_ARENA_MAX=2
MIMALLOC_ALLOW_THP=0

# Sessions in RAM only (no disk tier, no request log); text only; thinking off unless a request asks.
TF_DSV41_SESSIONS=1
TF_DSV41_SESSION_RAM_MIB=256
TF_DSV41_IMAGES=reject
TF_DSV41_VISION_FETCH=0
TF_DSV41_THINKING=0
TF_DSV41_DEFAULT_EFFORT=high

# RoCE over link-local GID 0 (no IPs on the QSFP ports); patch 0003 pairs f1 <-> f0 ports by NIC.
GLM53_TF_COMM_BACKEND=roce
GLM53_TF_ROCE_GID=0
GLM53_TF_ROCE_MAX_KB=1024
GLM53_TF_ROCE_FAST=1
TF_DSV41_PLAN_LINK=rdma
MASTER_PORT=29571
NCCL_GIN_ENABLE=0
NCCL_WIN_ENABLE=0
NCCL_DMABUF_ENABLE=0
NCCL_GRAPH_REGISTER=0
NCCL_LOCAL_REGISTER=0
NCCL_MNNVL_ENABLE=0
NCCL_IB_MERGE_NICS=0
NCCL_DEBUG=INFO

# Operations: no sudo cache drops (our guard releases cache), no automatic restarts, strict checks.
DROP_CACHES=0
MEM_GATE_GIB=0
CANARY=strict
PREFLIGHT=strict
READY_TIMEOUT=3600
WATCH_HEAL=0
